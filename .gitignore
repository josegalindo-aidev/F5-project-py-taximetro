# pyenv
#   For a library or package, you may want to ignore these files since version
#   control should be used for setup.py and pyproject.toml. However, you may
#   want to implement special rules for others:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, you may want to ignore this.
# Pipfile.lock

# Poetry
#   Similar to Pipfile.lock, it is general practice to include poetry.lock in version control.
#   https://python-poetry.org
# poetry.lock

# pdm
#   pyproject.toml is global, pdm.lock is local
# pdm.lock
.pdm.toml

# PEP 582; used by e.g. PDM, local packages
__pypackages__/

